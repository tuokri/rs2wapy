{% extends "debug/base.jinja" %}
{% block title %}Dashboard{% endblock %}
{% block content %}
  <section class="page-heading">
    <p class="eyebrow">Runtime briefing</p>
    <h1>{{ server.name }}</h1>
    <p>Seeded server state · {{ server.map_name }} · {{ server.game_type }}</p>
  </section>
  <section class="metrics" aria-label="Mock state summary">
    <article class="metric metric-ready"><span>Players</span><strong>{{ players | length }}</strong><small>Modelled</small></article>
    <article class="metric incomplete"><span>Chats</span><strong>—</strong><small>Not modelled</small></article>
    <article class="metric incomplete"><span>Bans</span><strong>—</strong><small>Not modelled</small></article>
    <article class="metric incomplete"><span>Sessions</span><strong>—</strong><small>Not modelled</small></article>
  </section>
  <section class="panel briefing-panel">
    <div class="section-heading">
      <p class="eyebrow">Read this first</p>
      <h2>Boilerplate boundary</h2>
    </div>
    <p>
      This panel renders seeded runtime state. Adding players is available from Player control;
      WebAdmin routes and the remaining debug actions stay as explicit stubs until their
      live-verified behavior is added.
    </p>
  </section>
{% endblock %}
